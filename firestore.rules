rules_version = '2';

// TLaaS pricing app — lead capture rules.
//
// Public visitors may CREATE a well-formed lead and nothing else. No client
// can read, update, or delete leads — you view them in the Firebase console (or
// a future authenticated rep view). Paste these in Firebase console → Firestore
// → Rules, or deploy with `firebase deploy --only firestore:rules`.
//
// Recommended: also enable App Check ENFORCEMENT for Firestore in the console
// (App Check → APIs → Cloud Firestore → Enforce). The app sends an App Check
// token when VITE_RECAPTCHA_SITE_KEY is set.

service cloud.firestore {
  match /databases/{database}/documents {

    match /leads/{leadId} {
      allow read, update, delete: if false;

      allow create: if
        // Exactly the fields the app writes — nothing injected.
        request.resource.data.keys().hasOnly(['createdAt', 'contact', 'municipality', 'quote', 'meta'])
        // Server timestamp only (prevents spoofed/backdated records).
        && request.resource.data.createdAt == request.time
        // Contact must be present and sane.
        && request.resource.data.contact.email is string
        && request.resource.data.contact.email.size() > 3
        && request.resource.data.contact.email.size() < 200
        && request.resource.data.contact.name is string
        && request.resource.data.contact.name.size() < 200
        // Basic municipality sanity.
        && request.resource.data.municipality.name is string
        && request.resource.data.municipality.name.size() < 200;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
