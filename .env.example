# Copy to .env and fill in. All VITE_* vars are embedded in the client bundle.

# Rep-mode shared passphrase (spec §9.2). Falls back to "civicchain" if unset.
VITE_REP_PASSPHRASE=civicchain

# ── Firebase (lead capture) ─────────────────────────────────────────────────
# From Firebase console → Project settings → Your apps → Web app → firebaseConfig.
# These are NOT secrets — the apiKey is a public project identifier. Firestore is
# secured by firestore.rules + App Check, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA v3 site key (Firebase console → App Check). Optional but
# strongly recommended for a public lead form. Leave blank to skip App Check.
VITE_RECAPTCHA_SITE_KEY=
